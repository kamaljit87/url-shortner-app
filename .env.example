# Used by docker-compose.prod.yml to configure the production stack.
# Copy this file to .env before running:
#   docker compose --env-file .env -f docker-compose.prod.yml pull
#   docker compose --env-file .env -f docker-compose.prod.yml up -d
#
# There is intentionally no plain docker-compose.yml in this repo — every
# invocation must name -f explicitly so a bare `docker compose up` in
# either the prod or dev checkout fails loudly instead of silently
# picking the wrong stack (this bit us once: a dev checkout stack got
# started against prod-shaped defaults and squatted on port 5432).
#
# Images are built and pushed to GHCR by CI — this stack pulls, it
# doesn't build locally. See BACKEND_IMAGE / FRONTEND_IMAGE below.
#
# The db, backend, and frontend containers have no published host ports —
# they're reachable only from other containers on app-network/proxy-network.
# The shared docker-compose.proxy.yml stack is the only thing that publishes
# host ports (80/443). See README.md for the reverse-proxy setup.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urlshortener

# Connection string the backend container actually uses. Note the host is
# "db" (the service name on app-network), not "localhost", and the port is
# Postgres's container-internal port 5432 (there is no published host port
# in production).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Backend
# BASE_URL is used to build short URLs shown to users, so it must match
# the public, browser-facing scheme (Cloudflare terminates HTTPS in front
# of this origin, so visitors always see https://).
BASE_URL=https://go2url.xyz
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# FRONTEND_URL is used for CORS and must match the Origin header the
# browser actually sends, which is https:// once Cloudflare is in front.
FRONTEND_URL=https://go2url.xyz

# Images to pull (pushed by CI). Override only if you're pointing at a
# different registry/tag than the workflow default (":prod").
# BACKEND_IMAGE=ghcr.io/kamaljit87/url-shortner-app-backend:prod
# FRONTEND_IMAGE=ghcr.io/kamaljit87/url-shortner-app-frontend:prod
